# Copy to .env or .env.local to override brand colors at build time.
# IMPORTANT: hex values MUST be quoted — bare # is treated as a comment by dotenv.
VITE_BRAND_GREEN="#25D366"
VITE_BRAND_GREEN_DARK="#1FB755"
VITE_BRAND_GREEN_SOFT="#DFF7E8"
VITE_BRAND_BLUE="#3041C7"
VITE_BRAND_BLUE_DARK="#232F9E"
VITE_BRAND_BLUE_SOFT="#E8EBFB"
