# Copy to .env or .env.local to override brand colors at build time.
# IMPORTANT: hex values MUST be quoted — bare # is treated as a comment by dotenv.
# Defaults below match the Official WhatsApp brand palette.
VITE_BRAND_GREEN="#25D366"
VITE_BRAND_GREEN_DARK="#128C7E"
VITE_BRAND_GREEN_SOFT="#DCF8C6"
VITE_BRAND_BLUE="#34B7F1"
VITE_BRAND_BLUE_DARK="#0288D1"
VITE_BRAND_BLUE_SOFT="#E1F5FE"
